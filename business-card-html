<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>Business Card</title>
  <link href="styles.css" rel="stylesheet" />"
</head>

<body>
<div class="business-card">
  <img class="profile-image" src="https://cdn.freecodecamp.org/curriculum/labs/flower.jpg" alt="pink flower labs">
  <p class="full-name">Sara</p>
  <p class="designation">Miss</p>
   <p class="company">Flow Consult</p>
   <hr>
   <p>Email Address</p>
   <p>Phone Number</p>
   <a href="www.saradonor.com" class="portfolio-link">Portfolio</a>
   <hr>
<div class="social-media">
<a href="twitter.com">Twitter</a>
  <a href="linkedin.com">LinkedIn</a>
<a href="Github.com">GitHub</a>
<h2>Connect with me<h2>
</div>
 
</body>

</html>


/* CSS */
body {
  background-color: rosybrown;
  font-family: arial, sans-serif;
}

.business-card {
  width: 300px;
  background-color: pink;
  padding: 20px;
  margin-top: 100px;
  text-align: center;
  font-size: 16px;
  margin-left: auto;
  margin-right: auto;
}

.profile-image {
  max-width: 100%;
}

p{
  margin-top: 5px;
  margin-bottom: 5px;
}

a {
  text-decoration: none;
}
