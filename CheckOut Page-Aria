<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Checkout Page</title>
</head>

<body>
<h1>Checkout</h1>
    <section>
    <img 
    src="https://cdn.freecodecamp.org/curriculum/labs/cube.jpg"
    alt="rubix cube"
    >
    <h2>Your Cart</h2>
 </section>

    <section>
<h2>Payment Information</h2>
<form>
    <label for="card-name">Card Name<span aria-hidden="true">*</span>
    </label>
     <input 
     id="card-name" 
     name="card-name"
     type="text"
     required>
     <br>
     <br>
            <label  
            for="card-number">Card Number<span aria-hidden="true">*</span>
            </label>
        
            <input
            id="card-number" 
            name="card-number" 
            aria-describedby="card-number-help"
            type="text" 
            required
                  > 
            <p id="card-number-help">Enter 16 digits</p>
        </section>
</body>

</html>
